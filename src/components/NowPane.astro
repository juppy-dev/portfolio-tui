---
import Pane from './Pane.astro';
import Icon from './Icon.astro';
import { getNow } from '../lib/content';
import { cycleColor } from '../lib/palette';

const now = await getNow();
---

<Pane title="now" id="now" icon="activity">
  <div class="now">
    <div class="now-badge" style={`--badge-color: var(--${now.artColor})`} aria-hidden="true">
      <Icon name="sparkle" size={26} />
    </div>
    <dl class="kv">
      {now.rows.map((row, i) => (
        <>
          <dt style={`color: var(--${cycleColor(i)})`}>{row.key}</dt>
          <dd>{row.value}</dd>
        </>
      ))}
    </dl>
  </div>
</Pane>
