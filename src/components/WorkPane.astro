---
import Pane from './Pane.astro';
import Icon from './Icon.astro';
import {
  getCertifications,
  getEducation,
  getExperience,
  getHighlights,
  getProjects,
} from '../lib/content';
import { cycleColor } from '../lib/palette';

const projects = await getProjects();
const experience = await getExperience();
const highlights = await getHighlights();
const certifications = await getCertifications();
const education = await getEducation();
const tabs = ['projects', 'experience', 'highlights', 'certification'] as const;

// Group items by their category field, preserving content order.
function groupBy<T>(items: readonly T[], key: (item: T) => string): Map<string, T[]> {
  const groups = new Map<string, T[]>();
  for (const item of items) {
    const k = key(item) || 'misc';
    if (!groups.has(k)) groups.set(k, []);
    groups.get(k)!.push(item);
  }
  return groups;
}

const highlightGroups = [...groupBy(highlights, (h) => h.category).entries()];
const certGroups = [...groupBy(certifications, (c) => c.category).entries()];
---

<Pane title="work" id="work" icon="folder">
  <div class="tabs" role="tablist" aria-label="work sections">
    {tabs.map((tab, i) => (
      <button role="tab" id={`tab-${tab}`} data-tab={tab} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${tab}`}>
        <span class="tab-num dim">{i + 1}</span>{tab}
      </button>
    ))}
  </div>

  <div data-tab-panel="projects" role="tabpanel" id="panel-projects" aria-labelledby="tab-projects">
    {projects.length === 0 && <p class="dim">// nothing here yet</p>}
    {projects.length > 0 && (
      <div class="sub-layout">
        <ul class="entries subnav">
          {projects.map((p, i) => (
            <li data-entry data-sub={`proj-${i}`} class:list={[{ selected: i === 0 }]}>
              <button class="entry-line">
                <span class="marker">▸</span> {p.name}
              </button>
            </li>
          ))}
        </ul>
        {projects.map((p, i) => (
          <div class="sub-content" data-sub-panel={`proj-${i}`} hidden={i !== 0}>
            <h3>{p.name} {p.year && <span class="year">{p.year}</span>}</h3>
            {p.blurb && <p class="dim sub-blurb">{p.blurb}</p>}
            <p class="prose">{p.details}</p>
            {p.links.length > 0 && (
              <p class="links">
                {p.links.map((l) => (
                  <a href={l.url}>{l.label}</a>
                ))}
              </p>
            )}
          </div>
        ))}
      </div>
    )}
  </div>

  <div data-tab-panel="experience" role="tabpanel" id="panel-experience" aria-labelledby="tab-experience" hidden>
    <p><a id="resume-link" href="/resume.pdf" download><Icon name="download" /> resume.pdf</a> <span class="dim desktop-hints">(or press d)</span></p>
    {experience.length === 0 && <p class="dim">// nothing here yet</p>}
    {experience.length > 0 && (
      <div class="sub-layout">
        <ul class="entries subnav">
          {experience.map((e, i) => (
            <li data-entry data-sub={`exp-${i}`} class:list={[{ selected: i === 0 }]}>
              <button class="entry-line">
                <span class="marker">▸</span> {e.role}
              </button>
            </li>
          ))}
        </ul>
        {experience.map((e, i) => (
          <div class="sub-content" data-sub-panel={`exp-${i}`} hidden={i !== 0}>
            <h3>{e.role} <span class="dim">@ {e.company}</span> <span class="year">{e.period}</span></h3>
            <ul class="bullets">
              {e.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
  </div>

  <div data-tab-panel="highlights" role="tabpanel" id="panel-highlights" aria-labelledby="tab-highlights" hidden>
    {highlights.length === 0 && <p class="dim">// nothing here yet</p>}
    {highlights.length > 0 && (
      <div class="sub-layout">
        <ul class="entries subnav">
          {highlightGroups.map(([category], i) => (
            <li data-entry data-sub={`hl-${i}`} class:list={[{ selected: i === 0 }]}>
              <button class="entry-line">
                <span class="marker">▸</span> {category}
              </button>
            </li>
          ))}
        </ul>
        {highlightGroups.map(([, items], i) => (
          <div class="sub-content" data-sub-panel={`hl-${i}`} hidden={i !== 0}>
            <ul class="entries">
              {items.map((h, j) => (
                <li>
                  <span style={`color: var(--${cycleColor(j)})`}>★</span> {h.text}
                  {h.year && <span class="year"> {h.year}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
  </div>

  <div data-tab-panel="certification" role="tabpanel" id="panel-certification" aria-labelledby="tab-certification" hidden>
    {certifications.length === 0 && education.length === 0 && <p class="dim">// nothing here yet</p>}
    {(certifications.length > 0 || education.length > 0) && (
      <div class="sub-layout">
        <ul class="entries subnav">
          {certGroups.map(([category], i) => (
            <li data-entry data-sub={`cert-${i}`} class:list={[{ selected: i === 0 }]}>
              <button class="entry-line">
                <span class="marker">▸</span> {category}
              </button>
            </li>
          ))}
          {education.length > 0 && (
            <li data-entry data-sub="cert-edu" class:list={[{ selected: certGroups.length === 0 }]}>
              <button class="entry-line">
                <span class="marker">▸</span> education
              </button>
            </li>
          )}
        </ul>
        {certGroups.map(([, items], i) => (
          <div class="sub-content" data-sub-panel={`cert-${i}`} hidden={i !== 0}>
            <ul class="entries">
              {items.map((c) => (
                <li>
                  <span class="marker">▸</span> {c.name}
                  {c.issuer && <span class="dim"> @ {c.issuer}</span>}
                  {c.year && <span class="year"> {c.year}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
        {education.length > 0 && (
          <div class="sub-content" data-sub-panel="cert-edu" hidden={certGroups.length > 0}>
            <ul class="entries">
              {education.map((e) => (
                <li>
                  <span class="marker">▸</span> {e.degree}
                  {e.school && <span class="dim"> @ {e.school}</span>}
                  {e.period && <span class="year"> {e.period}</span>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </div>
</Pane>
