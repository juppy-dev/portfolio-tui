---
import { getHero } from '../lib/content';

const hero = await getHero();
---

{
  hero && (
    <section class="hero" aria-label="Juppy Arroyo">
      <p class="hero-prompt dim">$ whoami</p>
      <pre class="hero-art" aria-hidden="true">{hero.art}</pre>
      <span class="hero-art-fallback">Juppy Arroyo</span>
      <p class="hero-tagline"><span class="accent">{hero.tagline}</span></p>
    </section>
  )
}
