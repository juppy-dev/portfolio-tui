---

{
  brand ? (
    <svg
      width={size}
      height={size}
      viewBox={brand.viewBox ?? '0 0 24 24'}
      fill="currentColor"
      aria-hidden="true"
    >
      <path d={brand.d} />
    </svg>
  ) : (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={STROKE_PATHS[name] ?? ''}
    />
  )
}
