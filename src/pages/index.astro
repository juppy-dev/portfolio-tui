---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/themes.css';
import '../styles/global.css';
import Pane from '../components/Pane.astro';
import NowPane from '../components/NowPane.astro';
import WorkPane from '../components/WorkPane.astro';
import ContactDialog from '../components/ContactDialog.astro';
import HelpDialog from '../components/HelpDialog.astro';
import Icon from '../components/Icon.astro';
import Hero from '../components/Hero.astro';
import UsesPane from '../components/UsesPane.astro';
import VitalsPane from '../components/VitalsPane.astro';
import PsPane from '../components/PsPane.astro';
import { getAbout, getTech, getHero } from '../lib/content';
import { cycleColor } from '../lib/palette';

const about = await getAbout();
const tech = await getTech();
const hero = await getHero();

// SEO / social. `site` is set in astro.config; fall back so dev never throws.
const SITE = Astro.site ?? new URL('https://juppy.dev');
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL('/og.png', SITE).href;
const title = 'hello@juppy.dev';
const tagline = hero?.tagline ?? 'software engineer';
const description = `${about.name} — ${tagline}`;
// Tab title stays playful; social cards lead with name + role for richer unfurls.
const socialTitle = `${about.name} — ${tagline.split('·')[0].trim()}`;
const sameAs = about.links.filter((l) => l.url.startsWith('http')).map((l) => l.url);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: about.name,
  url: SITE.href,
  email: 'hello@juppy.dev',
  jobTitle: tagline,
  sameAs,
};

// Split the about intro into paragraphs of text/code segments.
// `backtick` spans become highlighted code; done here (plain TS) because a
// backtick inside a regex literal confuses Astro's template lexer.
const BACKTICK = String.fromCharCode(96);
const codeSpan = new RegExp(`(${BACKTICK}[^${BACKTICK}]+${BACKTICK})`);
const aboutParagraphs = about.intro.split(/\n{2,}/).map((para) =>
  para
    .replace(/\n/g, ' ')
    .split(codeSpan)
    .filter(Boolean)
    .map((seg) => ({
      text: seg.startsWith(BACKTICK) ? seg.slice(1, -1) : seg,
      code: seg.startsWith(BACKTICK),
    }))
);

// Brand icon for a link label; undefined → plain "label ↗" link.
const LINK_ICONS: Record<string, string> = {
  github: 'github',
  linkedin: 'linkedin',
  instagram: 'instagram',
  threads: 'threads',
  email: 'mail',
};
---

<!doctype html>
<html lang="en" data-theme="andromeda">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={about.name} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#16161e" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={about.name} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <script is:inline>
      // Apply persisted theme + skip boot before first paint (no flash).
      const t = localStorage.getItem('theme');
      if (t) document.documentElement.dataset.theme = t;
      if (
        sessionStorage.getItem('booted') ||
        matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('no-boot');
      } else {
        // Hide panes/bars pre-paint so the intro can reveal them. Fail-safe:
        // if the intro module never runs, force the UI visible after 12s.
        document.documentElement.classList.add('intro');
        setTimeout(function () {
          document.documentElement.classList.remove('intro');
        }, 12000);
      }
    </script>
  </head>
  <body>
    <div id="boot" aria-hidden="true"><pre></pre></div>

    <div class="app">
      <header class="bar">
        <span><span class="ok">●</span> hello@juppy.dev</span>
        <button class="hire-me" data-action="contact">hire me <kbd>c</kbd></button>
      </header>

      <main class="grid">
        <Hero />

        <Pane title="about" id="about" icon="user">
          {aboutParagraphs.map((segments) => (
            <p class="prose">
              {segments.map((seg) =>
                seg.code ? <code class="hl">{seg.text}</code> : seg.text
              )}
            </p>
          ))}
          <p class="links">
            {about.links.map((l) => {
              const icon = LINK_ICONS[l.label.toLowerCase()];
              return (
                <a href={l.url} class:list={[{ 'has-icon': !!icon }]}>
                  {icon && <Icon name={icon} size={13} />}
                  {l.label}
                </a>
              );
            })}
          </p>
        </Pane>

        <NowPane />

        <WorkPane />

        <Pane title="tech" id="tech" icon="cpu">
          {tech.length === 0 && <p class="dim">// nothing here yet</p>}
          {tech.map((group, gi) => (
            <div class="tech-group" style={`--gc: var(--${cycleColor(gi)})`}>
              <span class="label">{group.name}</span>
              {group.items.map((item) => (
                <span class="badge">{item}</span>
              ))}
            </div>
          ))}
        </Pane>

        <UsesPane />

        <PsPane />

        <VitalsPane />
      </main>

      <footer class="bar status-bar">
        <span class="hints">
          <span class="desktop-hints"><kbd>tab</kbd> pane · <kbd>1-4</kbd> work · <kbd>j/k</kbd> nav</span>
          <button data-action="contact"><Icon name="mail" /> contact <kbd>c</kbd></button>
          <button data-action="theme"><Icon name="palette" /> <span data-theme-label>tokyo-nebula</span> <kbd>t</kbd></button>
          <button data-action="help"><Icon name="help" /> help <kbd>?</kbd></button>
        </span>
        <span><span class="clock" data-clock></span><span class="mode">NORMAL</span></span>
      </footer>
    </div>

    <ContactDialog />
    <HelpDialog />

    <script>
      import '../scripts/tui.ts';
    </script>
  </body>
</html>
